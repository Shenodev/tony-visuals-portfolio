# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string
MONGODB_URI=
# Used to sign admin session cookies (long random string)
COOKIE_SECRET=
# Plaintext admin password (compared in constant time server-side)
ADMIN_PASSWORD=
# Cloudinary credentials (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Resend
RESEND_API_KEY=
# Where contact-form notifications are delivered
CONTACT_EMAIL=
# Verified sender address, e.g. onboarding@resend.dev
RESEND_FROM=